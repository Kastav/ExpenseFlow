# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE WEB CONFIGURATION (For Firebase Analytics)
# Obtain these from your Firebase Console under Project Settings > Your Apps > Web App
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="expenseflow-ad899"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# PLAY_BILLING_SIGNING_SECRET: Cryptographic secret for signing verified subscription entitlement tokens.
# Must be at least 16 characters. Production verification fails closed without this secret.
PLAY_BILLING_SIGNING_SECRET="expenseflow_prod_signing_secret_min_16_chars"

# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY: Google Cloud Service Account JSON for Google Play Developer API (androidpublisher v3)
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# NODE_ENV: Set to "production" on Cloud Run / production deployments (enforces Firestore + strict CORS)
NODE_ENV="development"

# ALLOWED_ORIGINS: Comma-separated list of permitted frontend origins for CORS in production
ALLOWED_ORIGINS="https://expenseflow-2984.ai.studio"

# VITE_API_BASE_URL: HTTPS backend origin required for Capacitor Android builds (e.g., https://expenseflow-api-xxxx.a.run.app)
# Leave empty in local web dev to use same-origin Express/Vite proxy.
VITE_API_BASE_URL=""

# ENTITLEMENT_STORE_BACKEND: Explicit persistence backend ("firestore" required in NODE_ENV=production; "file" allowed only in dev/test)
# Production fails closed if ENTITLEMENT_STORE_BACKEND!="firestore" or Firebase Admin credentials are missing.
ENTITLEMENT_STORE_BACKEND="file"

# ENTITLEMENT_STORE_PATH: Local durable JSON store path used strictly when ENTITLEMENT_STORE_BACKEND="file" (dev/test only)
ENTITLEMENT_STORE_PATH=".data/entitlements.json"

# FIREBASE_SERVICE_ACCOUNT_KEY: Service account JSON for Firebase Admin SDK (project: expenseflow-ad899)
# Used server-side only to verify Firebase ID tokens and read/write Firestore billing entitlements & AI quotas.
# On Cloud Run running inside project expenseflow-ad899, set USE_GCP_ADC="true" instead of inline JSON.
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "expenseflow-ad899", ...}'

# USE_GCP_ADC: Set to "true" on Cloud Run to use Application Default Credentials instead of inline JSON
# USE_GCP_ADC="true"

# FIRESTORE_DATABASE_ID: Optional non-default Firestore database ID
# FIRESTORE_DATABASE_ID=""

# GOOGLE_PUBSUB_AUDIENCE: Required to enable Google Play Real-Time Developer Notifications (/api/billing/rtdn)
# GOOGLE_PUBSUB_AUDIENCE="https://expenseflow-api-xxxx.a.run.app/api/billing/rtdn"

# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL: Expected OIDC push service account email for Pub/Sub authentication
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL="pubsub-invoker@expenseflow-ad899.iam.gserviceaccount.com"

