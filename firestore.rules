rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all public access across the database
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * Premium Waitlist Collection:
     * Stores customer emails, consent status, and pricing preferences for ExpenseFlow Premium.
     *
     * SECURITY INVARIANT:
     * - ZERO client-side reads: Prevents competitors or unauthorized users from scraping subscriber emails.
     * - ZERO client-side direct writes: Enforces server-side validation, duplicate prevention, RFC compliance,
     *   and rate-limiting through Firebase Admin SDK in Cloud Functions / secure backend proxy.
     */
    match /premium_waitlist/{waitlistId} {
      allow read, write: if false;
    }
  }
}
