rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all public access across the database
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * Premium Waitlist Collection:
     * Accessed strictly via Firebase Admin SDK on the Express backend.
     */
    match /premium_waitlist/{waitlistId} {
      allow read, write: if false;
    }

    /**
     * Backend-Only Billing Entitlements, User Entitlement Index, Token Index, RTDN Ledger & AI Quotas:
     * Accessed strictly via Firebase Admin SDK on the Express backend.
     * Clients NEVER read or write billing, entitlement, or quota documents directly.
     */
    match /billing_entitlements/{tokenHash} {
      allow read, write: if false;
    }

    match /user_entitlements/{uidHash} {
      allow read, write: if false;
    }

    match /billing_token_index/{tokenId} {
      allow read, write: if false;
    }

    match /rtdn_notifications/{messageId} {
      allow read, write: if false;
    }

    match /ai_usage_quotas/{subjectKey} {
      allow read, write: if false;
    }

    /**
     * User-Scoped Cloud Sync & Backup Documents:
     * Accessed exclusively via Firebase Admin SDK routes (/api/cloud-sync/*)
     * after verifying both Firebase ID Token AND active Google Play Premium entitlement.
     * Direct client-SDK reads/writes are blocked so unverified/free clients cannot bypass Premium gating.
     */
    match /users/{userId}/cloud_sync/{docId} {
      allow read, write: if false;
    }
  }
}
