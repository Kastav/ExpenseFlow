name: Build ExpenseFlow Android App Bundle (AAB)

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-aab:
    name: Build Signed Android App Bundle
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Run automated test suites
        run: bun run test

      - name: Build Web Production Assets
        run: bun run build

      - name: Sync Capacitor Android
        run: bunx cap sync android

      - name: Set up Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Verify Android SDK
        run: |
          echo "ANDROID_HOME=$ANDROID_HOME"
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
          test -d "$ANDROID_HOME"
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --version || true
          "$ANDROID_HOME/platform-tools/adb" version || true

      - name: Grant execute permission for Gradle wrapper
        run: chmod +x android/gradlew

      - name: Build Android App Bundle (AAB)
        run: cd android && ./gradlew bundleRelease --stacktrace

      - name: Sign Release AAB (if keystore provided in secrets)
        id: sign_step
        env:
          KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ] && [ -n "$KEYSTORE_PASSWORD" ] && [ -n "$KEY_ALIAS" ] && [ -n "$KEY_PASSWORD" ]; then
            echo "Keystore secrets present. Signing Android App Bundle..."
            echo "$KEYSTORE_BASE64" | base64 --decode > android/app/release.keystore
            jarsigner -verbose -sigalg SHA256withRSA -digestalg SHA-256 \
              -keystore android/app/release.keystore \
              -storepass "$KEYSTORE_PASSWORD" \
              -keypass "$KEY_PASSWORD" \
              android/app/build/outputs/bundle/release/app-release.aab "$KEY_ALIAS"
            mv android/app/build/outputs/bundle/release/app-release.aab android/app/build/outputs/bundle/release/expenseflow-signed-release.aab
            echo "signed=true" >> $GITHUB_OUTPUT
            echo "::notice ::Android App Bundle signed successfully for Google Play Store release."
          else
            echo "::warning ::Release signing credentials are not configured. The generated AAB is UNSIGNED and cannot be uploaded directly to Google Play."
            mv android/app/build/outputs/bundle/release/app-release.aab android/app/build/outputs/bundle/release/expenseflow-unsigned-build.aab
            echo "signed=false" >> $GITHUB_OUTPUT
          fi

      - name: Upload Android App Bundle Artifact
        uses: actions/upload-artifact@v4
        with:
          name: expenseflow-android-bundle
          path: android/app/build/outputs/bundle/release/*.aab
          if-no-files-found: error
