+interface LocalCloudSyncFileState {
+  users: Record<
+    string,
+    {
+      snapshot?: StoredCloudSyncSnapshot;
+      previousSnapshot?: StoredCloudSyncSnapshot;
+      rateLimit?: number[];
+    }
+  >;
+}
