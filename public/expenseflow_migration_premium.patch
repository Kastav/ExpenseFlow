+        strategicGuidance,
+        generatedAt: new Date(nowMs).toISOString(),
+        usage: authz.usage,
+      } satisfies AdvancedAiInsightsResponsePayload);
+    } catch (err: unknown) {
+      const errorMessage = err instanceof Error ? err.message : String(err);
+      if (errorMessage === 'REQUEST_TIMEOUT') {
+        res.status(504).json({
+          success: false,
+          error: 'server_error',
