+  async consumeRateLimit(uid: string, nowMs: number, maxPerMinute: number) {
+    const list = (this.rates.get(uid) || []).filter((ts) => ts > nowMs - 60_000);
+    if (list.length >= maxPerMinute) return false;
+    list.push(nowMs);
+    this.rates.set(uid, list);
